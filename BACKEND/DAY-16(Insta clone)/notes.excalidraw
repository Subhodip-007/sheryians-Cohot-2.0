      "type": "text",
      "x": 1448.3600097497092,
      "y": 686.6403470031206,
      "width": 302.28076171875,
      "height": 49.83869983303929,
      "angle": 0,
      "strokeColor": "#ffec99",
      "backgroundColor": "#ffec99",
