      "text": "    Username:{\n        type:String,\n        unique:[true,\"username already exist\"],\n        required:[true,\"user name is required\"],\n    },\n    Email:{\n        type:String,\n        unique:[true,\"Email already exist\"],\n        required:[true,\"Email name is required\"],\n    },\n    Password:{\n        type:String,\n        required:[true,\"Password is required\"],\n    },\n    Bio:{\n        type:String,\n    },\n    ProfileImage:{ // insta has a defaule profile\nimage..\n        type: String,\n\ndefault:\"https://ik.imagekit.io/e30yzaknwc/default\n%20ing.png\"\n    }  user_id",
